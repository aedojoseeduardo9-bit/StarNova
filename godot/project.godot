; Star Nova (Godot 4.7). Ver CLAUDE.md.
config_version=5

[application]

config/name="Star Nova"
config/description="Pip, una ardilla diminuta, recorre islas flotantes para reunir los fragmentos de la estrella Nova."
config/version="0.8.0"
config/build=0
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.984, 0.882, 0.812, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Juego="*res://scripts/juego.gd"
Datos="*res://scripts/datos.gd"
Sfx="*res://scripts/sfx.gd"
Hud="*res://scripts/hud.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
textures/vram_compression/import_etc2_astc=true
